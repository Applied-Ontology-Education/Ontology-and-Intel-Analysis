# V04. Which words did each document add to the vocabulary?
# A label (preferred or alternative) on a class or a parked SKOS concept,
# listed under the first document that used it. The base labels in
# meeting-mandate.ttl are not counted: they come with the pattern. The term
# names are read from the base graph (pattern + CCO module).
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?document ?term ?label ?language WHERE {
  GRAPH ?g { ?t ?lp ?label . ?g dcterms:date ?d ; dcterms:title ?document . }
  VALUES ?lp { skos:prefLabel skos:altLabel }
  FILTER NOT EXISTS { GRAPH ?g0 { ?t ?lp0 ?label . ?g0 dcterms:date ?d0 . } FILTER (?d0 < ?d) }
  BIND (LANG(?label) AS ?language)
  OPTIONAL { GRAPH <https://github.com/luay9/meeting-mandate/graph/base> { ?t rdfs:label ?tl } FILTER (LANG(?tl) = "en") }
  BIND (COALESCE(STR(?tl), REPLACE(STR(?t), "^.*[#/]", "")) AS ?term)
}
ORDER BY ?document ?term ?label
