# Synthetic document D03 for the sustained-extendability test (see EXTENDABILITY.md).
# No real people, organisations or programmes. One file = one document = one named graph.

@prefix :     <https://github.com/luay9/meeting-mandate#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  Relation declarations (the same block in every file; see BUILD.md)
#################################################################

obo:BFO_0000055 a owl:ObjectProperty .   # realizes
obo:BFO_0000057 a owl:ObjectProperty .   # has participant
obo:BFO_0000063 a owl:ObjectProperty .   # precedes
obo:BFO_0000101 a owl:ObjectProperty .   # is carrier of
obo:BFO_0000115 a owl:ObjectProperty .   # has member part
obo:BFO_0000117 a owl:ObjectProperty .   # has occurrent part
obo:BFO_0000132 a owl:ObjectProperty .   # occurrent part of
obo:BFO_0000178 a owl:ObjectProperty .   # has continuant part
obo:BFO_0000196 a owl:ObjectProperty .   # bearer of
cco:ont00001833 a owl:ObjectProperty .   # has agent
cco:ont00001986 a owl:ObjectProperty .   # has output
cco:ont00001816 a owl:ObjectProperty .   # is output of
cco:ont00001942 a owl:ObjectProperty .   # prescribes
cco:ont00001916 a owl:ObjectProperty .   # designates
skos:altLabel   a owl:AnnotationProperty .
skos:prefLabel  a owl:AnnotationProperty .
skos:scopeNote  a owl:AnnotationProperty .

<https://github.com/luay9/meeting-mandate/graph/D03> a owl:Ontology ;
    dcterms:title "D03: presentation for meeting 3"@en ;
    dcterms:date "2025-10-15" ;
    dcterms:description "Breadth. The first deck. It brings in a new branch, the programme objectives, and links them to work that minutes D01 and D02 already hold. It also uses the term KPI, which is parked as a SKOS concept because no competency question needs it yet."@en .

#################################################################
#  The deck and its file (first use of :MeetingPresentation)
#################################################################

:deck_3 a owl:NamedIndividual , :MeetingPresentation ;
    rdfs:label "status deck, meeting 3"@en ;
    obo:BFO_0000178 :objective_1 , :objective_2 .         # has continuant part

:deck_file_3 a owl:NamedIndividual , cco:ont00000253 ;   # Information Bearing Entity
    rdfs:label "deck file, meeting 3"@en ;
    obo:BFO_0000101 :deck_3 .                             # is carrier of

#################################################################
#  New branch: objectives. They prescribe work that is already in the base.
#################################################################

:objective_1 a owl:NamedIndividual , cco:ont00000476 ;   # Objective
    rdfs:label "Program A objective 1: operating model in place"@en ;
    cco:ont00001942 :work_m01_v1_0 , :work_m06_v1_0 .     # prescribes (work from D01, D02)

:objective_2 a owl:NamedIndividual , cco:ont00000476 ;   # Objective
    rdfs:label "Program A objective 2: partners engaged"@en ;
    cco:ont00001942 :work_m02_v1_0 , :work_m05_v1_0 .

#################################################################
#  Language: words the deck uses
#################################################################

:MeetingPresentation skos:altLabel "deck"@en , "عرض تقديمي"@ar .
cco:ont00000476 skos:altLabel "هدف"@ar .                 # Objective

# Rule 2: a new class only when a competency question needs it.
# No question asks about KPIs yet, so the term is kept as a SKOS concept,
# with no OWL class and no BFO/CCO parent.
:concept_kpi a owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "key performance indicator"@en , "مؤشر أداء رئيسي"@ar ;
    skos:altLabel "KPI"@en ;
    skos:scopeNote "Parked in the vocabulary. It becomes a class only when a competency question needs it."@en .
