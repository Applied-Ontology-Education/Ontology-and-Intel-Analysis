skos:scopeNote  a owl:AnnotationProperty .

<https://github.com/luay9/meeting-mandate/graph/D02> a owl:Ontology ;
    dcterms:title "D02: minutes of meeting 2"@en ;
    dcterms:date "2025-09-18" ;
    dcterms:description "Depth. The same kinds of thing as D01, only more of them: a second meeting and two more mandates. One new word: these minutes call a mandate by a different Arabic name."@en .

#################################################################
#  Meeting 2: issues M05 v1.0 and M06 v1.0
#  Reuses chair_1, authority_role_1, secretary_1 and attendees_1 from D01.
#################################################################

:meeting_2 a owl:NamedIndividual , cco:ont00000144 ;     # Act of Meeting
    rdfs:label "meeting 2"@en ;
    cco:ont00001833 :attendees_1 ;
    obo:BFO_0000117 :deciding_m05_v1_0 , :deciding_m06_v1_0 .

