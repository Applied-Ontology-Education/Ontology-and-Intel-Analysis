# Synthetic document D01 for the sustained-extendability test (see EXTENDABILITY.md).
# No real people, organisations or programmes. One file = one document = one named graph.

@prefix :     <https://github.com/luay9/meeting-mandate#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#################################################################
#  Relation declarations (the same block in every file; see BUILD.md)
#################################################################

obo:BFO_0000055 a owl:ObjectProperty .   # realizes
obo:BFO_0000057 a owl:ObjectProperty .   # has participant
obo:BFO_0000063 a owl:ObjectProperty .   # precedes
obo:BFO_0000101 a owl:ObjectProperty .   # is carrier of
obo:BFO_0000115 a owl:ObjectProperty .   # has member part
obo:BFO_0000117 a owl:ObjectProperty .   # has occurrent part
obo:BFO_0000132 a owl:ObjectProperty .   # occurrent part of
obo:BFO_0000178 a owl:ObjectProperty .   # has continuant part
obo:BFO_0000196 a owl:ObjectProperty .   # bearer of
cco:ont00001833 a owl:ObjectProperty .   # has agent
cco:ont00001986 a owl:ObjectProperty .   # has output
cco:ont00001816 a owl:ObjectProperty .   # is output of
cco:ont00001942 a owl:ObjectProperty .   # prescribes
cco:ont00001916 a owl:ObjectProperty .   # designates
skos:altLabel   a owl:AnnotationProperty .
skos:prefLabel  a owl:AnnotationProperty .
skos:scopeNote  a owl:AnnotationProperty .

<https://github.com/luay9/meeting-mandate/graph/D01> a owl:Ontology ;
    dcterms:title "D01: minutes of meeting 1"@en ;
    dcterms:date "2025-07-10" ;
    dcterms:description "The first document ingested. It founds the base: the chair, the authority role, the group, the first meeting and two mandates."@en .

#################################################################
#  Who: the chair, the role, the group
#################################################################

:chair_1 a owl:NamedIndividual , cco:ont00001262 ;       # Person
    rdfs:label "chair 1"@en ;
    obo:BFO_0000196 :authority_role_1 .                   # bearer of

:authority_role_1 a owl:NamedIndividual , cco:ont00000187 ;   # Authority Role
    rdfs:label "authority role of chair 1"@en .

:secretary_1 a owl:NamedIndividual , cco:ont00001262 ;   # Person
    rdfs:label "secretary 1"@en .

:attendees_1 a owl:NamedIndividual , cco:ont00000914 ;   # Group of Persons
    rdfs:label "Program A steering group"@en ;
    obo:BFO_0000115 :chair_1 , :secretary_1 .             # has member part

#################################################################
#  Meeting 1: issues M01 v1.0 and M02 v1.0
#################################################################

:meeting_1 a owl:NamedIndividual , cco:ont00000144 ;     # Act of Meeting
    rdfs:label "meeting 1"@en ;
    cco:ont00001833 :attendees_1 ;                        # has agent
    obo:BFO_0000117 :deciding_m01_v1_0 , :deciding_m02_v1_0 .   # has occurrent part

:deciding_m01_v1_0 a owl:NamedIndividual , cco:ont00000133 ;   # Act of Directive Communication
    rdfs:label "deciding M01 v1.0"@en ;
    cco:ont00001833 :chair_1 ;                            # has agent
    obo:BFO_0000055 :authority_role_1 ;                   # realizes
    cco:ont00001986 :m01_v1_0 ;                           # has output
    obo:BFO_0000063 :documenting_1 .                      # precedes

:deciding_m02_v1_0 a owl:NamedIndividual , cco:ont00000133 ;
    rdfs:label "deciding M02 v1.0"@en ;
    cco:ont00001833 :chair_1 ;
    obo:BFO_0000055 :authority_role_1 ;
    cco:ont00001986 :m02_v1_0 ;
    obo:BFO_0000063 :documenting_1 .

:documenting_1 a owl:NamedIndividual , cco:ont00000438 ;   # Act of Official Documentation
    rdfs:label "documenting meeting 1"@en ;
    cco:ont00001833 :secretary_1 ;
    cco:ont00001986 :minutes_file_1 .

:minutes_file_1 a owl:NamedIndividual , cco:ont00000253 ;  # Information Bearing Entity
    rdfs:label "minutes file, meeting 1"@en ;
    obo:BFO_0000101 :minutes_1 .                          # is carrier of

:minutes_1 a owl:NamedIndividual , :MeetingMinutes ;
    rdfs:label "minutes of meeting 1"@en ;
    obo:BFO_0000178 :m01_v1_0 , :id_m01_v1_0 ,            # has continuant part
                    :m02_v1_0 , :id_m02_v1_0 .

:m01_v1_0 a owl:NamedIndividual , :Mandate ; rdfs:label "mandate M01 v1.0 (scope)"@en ;
    cco:ont00001942 :work_m01_v1_0 .                      # prescribes
:m02_v1_0 a owl:NamedIndividual , :Mandate ; rdfs:label "mandate M02 v1.0 (incentive terms)"@en ;
    cco:ont00001942 :work_m02_v1_0 .

:id_m01_v1_0 a owl:NamedIndividual , :MandateIdentifier ; rdfs:label "M01 v1.0" ; cco:ont00001916 :m01_v1_0 .
:id_m02_v1_0 a owl:NamedIndividual , :MandateIdentifier ; rdfs:label "M02 v1.0" ; cco:ont00001916 :m02_v1_0 .

:work_m01_v1_0 a owl:NamedIndividual , cco:ont00000228 ; rdfs:label "define programme scope"@en .   # Planned Act
:work_m02_v1_0 a owl:NamedIndividual , cco:ont00000228 ; rdfs:label "draft incentive terms"@en .
