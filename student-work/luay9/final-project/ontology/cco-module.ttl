                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ] ;
                                                   rdfs:subClassOf <https://www.commoncoreontologies.org/ont00000686> ;
                                                   rdfs:label "Spatial Region Identifier"@en ;
