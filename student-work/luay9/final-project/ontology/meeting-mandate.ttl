@prefix :     <https://github.com/luay9/meeting-mandate#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://github.com/luay9/meeting-mandate> a owl:Ontology ;
    dcterms:title "Meeting & Mandate ontology"@en ;
    dcterms:description "Design pattern for executive meetings, the mandates they produce, and the documents that carry them. Built on BFO and CCO (extracted module: cco-module.ttl); aligned to IAO by SKOS mappings only."@en ;
    dcterms:creator "Luay Assidmi" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1" .

#################################################################
#  Relation declarations
#  Repeated in every .ttl file. Without them ROBOT parses each file on
#  its own, reads undeclared relations as annotations, and HermiT never
#  sees them.
#################################################################

obo:BFO_0000055 a owl:ObjectProperty .   # realizes
obo:BFO_0000057 a owl:ObjectProperty .   # has participant
obo:BFO_0000063 a owl:ObjectProperty .   # precedes
obo:BFO_0000101 a owl:ObjectProperty .   # is carrier of
obo:BFO_0000115 a owl:ObjectProperty .   # has member part
obo:BFO_0000117 a owl:ObjectProperty .   # has occurrent part
obo:BFO_0000132 a owl:ObjectProperty .   # occurrent part of
obo:BFO_0000178 a owl:ObjectProperty .   # has continuant part
obo:BFO_0000196 a owl:ObjectProperty .   # bearer of
cco:ont00001833 a owl:ObjectProperty .   # has agent
cco:ont00001986 a owl:ObjectProperty .   # has output
cco:ont00001816 a owl:ObjectProperty .   # is output of
cco:ont00001942 a owl:ObjectProperty .   # prescribes
cco:ont00001916 a owl:ObjectProperty .   # designates

# SKOS mapping properties stay annotations: the IAO alignment must never
# reach the reasoner.
skos:exactMatch a owl:AnnotationProperty .
skos:closeMatch a owl:AnnotationProperty .
skos:prefLabel  a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .

#################################################################
#  Classes
#################################################################

# Decision meeting ≡ Act of Meeting
#   and (has occurrent part some
#         (Act of Directive Communication
#          and (has agent some (Person and (bearer of some Authority Role)))
#          and (has output some Mandate)))
:DecisionMeeting a owl:Class ;
    rdfs:label "decision meeting"@en ;
    skos:prefLabel "decision meeting"@en , "اجتماع قرار"@ar ;
    skos:definition "A meeting that has as part at least one act of directive communication, performed by a person who bears an authority role, whose output is a mandate."@en ;
    rdfs:comment "Defined class. Membership is inferred by the reasoner and is never asserted. A meeting where nothing is decided (a status briefing) remains an Act of Meeting without being classified here."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            cco:ont00000144                              # Act of Meeting
            [ a owl:Restriction ;
              owl:onProperty obo:BFO_0000117 ;           # has occurrent part
              owl:someValuesFrom [ a owl:Class ;
                  owl:intersectionOf (
                      cco:ont00000133                    # Act of Directive Communication
                      [ a owl:Restriction ;
                        owl:onProperty cco:ont00001833 ; # has agent
                        owl:someValuesFrom [ a owl:Class ;
                            owl:intersectionOf (
                                cco:ont00001262          # Person
                                [ a owl:Restriction ;
                                  owl:onProperty obo:BFO_0000196 ;   # bearer of
                                  owl:someValuesFrom cco:ont00000187 ] ) ] ]   # Authority Role
                      [ a owl:Restriction ;
                        owl:onProperty cco:ont00001986 ; # has output
                        owl:someValuesFrom :Mandate ] ) ] ] ) ] .

# Mandate ⊑ Process Regulation
#   and (is output of some (Act of Directive Communication
#                           and (occurrent part of some Act of Meeting)))
:Mandate a owl:Class ;
    rdfs:label "mandate"@en ;
    skos:prefLabel "mandate"@en , "توجيه"@ar ;
    skos:definition "A process regulation that is the output of an act of directive communication performed in a meeting."@en ;
    rdfs:comment "Each version of a mandate (M06 v1.0, M06 v1.1) is a distinct mandate. Recurrence is modelled by the earlier act of deciding preceding the later one, not by a version attribute."@en ;
    rdfs:subClassOf cco:ont00001324 ,                    # Process Regulation
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001816 ;               # is output of
          owl:someValuesFrom [ a owl:Class ;
              owl:intersectionOf (
                  cco:ont00000133                        # Act of Directive Communication
                  [ a owl:Restriction ;
                    owl:onProperty obo:BFO_0000132 ;     # occurrent part of
                    owl:someValuesFrom cco:ont00000144 ] ) ] ] ;   # Act of Meeting
    skos:closeMatch obo:IAO_0000033 .                    # directive information entity

# Meeting minutes ⊑ Report
# Deliberately NOT "has continuant part some Mandate": a status briefing
# has minutes and no mandate. The part relation is asserted per individual.
:MeetingMinutes a owl:Class ;
    rdfs:label "meeting minutes"@en ;
    skos:prefLabel "meeting minutes"@en , "محضر اجتماع"@ar ;
    skos:definition "A report that conveys an account of a meeting, including any mandates issued in it, and is recorded for official use by those who must act on it."@en ;
    rdfs:subClassOf cco:ont00002043 ;                    # Report
    skos:exactMatch obo:IAO_0000088 .                    # report

:OfficialLetter a owl:Class ;
    rdfs:label "official letter"@en ;
    skos:prefLabel "official letter"@en , "خطاب رسمي"@ar ;
    skos:definition "A document content entity that is addressed by one agent to another in an official capacity, and may restate or cite a mandate by its identifier."@en ;
    rdfs:subClassOf cco:ont00002039 ;                    # Document Content Entity
    skos:closeMatch obo:IAO_0000310 .                    # document

:MeetingPresentation a owl:Class ;
    rdfs:label "meeting presentation"@en ;
    skos:prefLabel "meeting presentation"@en , "عرض اجتماع"@ar ;
    skos:definition "A document content entity that is prepared to be shown to the participants of a meeting, setting out the topics they are to address."@en ;
    rdfs:subClassOf cco:ont00002039 ;                    # Document Content Entity
    skos:closeMatch obo:IAO_0000310 .                    # document

# Mandate identifier ⊑ Non-Name Identifier and (designates some Mandate)
:MandateIdentifier a owl:Class ;
    rdfs:label "mandate identifier"@en ;
    skos:prefLabel "mandate identifier"@en , "معرّف التوجيه"@ar ;
    skos:definition "A non-name identifier that designates a mandate, consisting of a mandate number and a version, such as 'M06 v1.1'."@en ;
    rdfs:comment "Works like a tracking number (Smith, Document Acts, p. 10): the same identifier in the minutes, a follow-up letter and a tracker links all three to one mandate."@en ;
    rdfs:subClassOf cco:ont00000649 ,                    # Non-Name Identifier
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001916 ;               # designates
          owl:someValuesFrom :Mandate ] ;
    skos:closeMatch obo:IAO_0020000 .                    # identifier
